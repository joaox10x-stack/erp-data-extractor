# ERP Login
ERP_BASE_URL=https://your-erp-system.com
ERP_USER=your_username
ERP_PASS=your_password

# Module
ERP_MODULE=Gestão de Montagem

# Record Types (comma-separated)
RECORD_TYPES=3,5

# Output
OUT_DIR=./output

# Scraper
LIMIT=200
HEADLESS=1
SLOWMO=0
VIA=1

# Declaration crop region
DECL_CLIP_X=640
DECL_CLIP_Y=110
DECL_CLIP_W=760
DECL_CLIP_H=980

# Phone extractor
DECLARATIONS_DIR=./output/declarations
WEBHOOK_URL=https://your-webhook-url/update-phone
